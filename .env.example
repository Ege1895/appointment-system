# --- ASP.NET CORE SETTINGS ---
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# --- DATABASE (POSTGRESQL) ---
# Docker Compose içindeki servis adını kullanın (Host=postgres)
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=appointment_system;Username=appointment;Password=YOUR_STRONG_PASSWORD_HERE
POSTGRES_PASSWORD=YOUR_STRONG_PASSWORD_HERE

# --- CACHE (REDIS) ---
ConnectionStrings__Redis=redis:6379

# --- SECURITY (JWT) ---
# En az 32-64 karakterlik rastgele bir anahtar kullanın
Jwt__SecretKey=YOUR_SECURE_RANDOM_SECRET_KEY_HERE
Jwt__Issuer=yourdomain.com
Jwt__Audience=yourdomain.com
Jwt__ExpirationMinutes=15

# --- CORS ---
Cors__AllowedOrigins__0=https://yourdomain.com

# --- OPTIONAL: LOGGING (ELASTICSEARCH) ---
Elastic__Uri=
